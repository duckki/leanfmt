def proofField : Equivalence where
  left_inv f := Subtype.ext <| funext <| Fin.forall_fin_two.2 <| by
    simp [← (show f.1 0 + f.1 1 = 1 by simpa using f.2.2)]

theorem proofCalc : True := by
  have := calc
    first = second := by
      simpa [identity] using proof
    _ = third := anotherProof
  exact result

def quotedResult := do
  let result ← withAppArg do
    let value ← withNaryFn delab
    `(Nat) >>= annotateGoToSyntaxDef
  `(Nat) >>= annotateGoToSyntaxDef

def quotedPipe :=
  match ref with
  | ref =>
    MetaM.run' do
      if condition then
        liftCommandElabM <| Command.elabCommand <| ←
          `(command| attribute [simp] -- Keep the quoted comment.
            theoremName)
      return result

